{
  "pipeline": {
    "name": "todo-react-pipeline",
    "roleArn": "arn:aws:iam::022112164130:role/service-role/AWSCodePipelineServiceRole-us-east-1-todo-react-pipeline",
    "artifactStore": {
      "type": "S3",
      "location": "codepipeline-us-east-1-30e1e456282a-4bf1-9e6c-be80f59db298"
    },
    "stages": [
      {
        "name": "Source",
        "actions": [
          {
            "name": "Source",
            "actionTypeId": {
              "category": "Source",
              "owner": "AWS",
              "provider": "CodeStarSourceConnection",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "BranchName": "main",
              "ConnectionArn": "arn:aws:codeconnections:us-east-1:022112164130:connection/a22849a8-134b-49ee-9ee4-3430a335fa9d",
              "FullRepositoryId": "U-krishna/todo-react",
              "OutputArtifactFormat": "CODE_ZIP"
            },
            "outputArtifacts": [
              {
                "name": "SourceArtifact"
              }
            ],
            "inputArtifacts": [],
            "region": "us-east-1"
          }
        ],
        "onFailure": {
          "result": "RETRY",
          "retryConfiguration": {
            "retryMode": "ALL_ACTIONS"
          }
        }
      },
      {
        "name": "Test",
        "actions": [
          {
            "name": "Testing",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "BuildspecOverride": "buildspec-test.yml",
              "ProjectName": "todo-react-test"
            },
            "outputArtifacts": [],
            "inputArtifacts": [
              {
                "name": "SourceArtifact"
              }
            ],
            "region": "us-east-1"
          }
        ],
        "onFailure": {
          "result": "RETRY",
          "retryConfiguration": {
            "retryMode": "ALL_ACTIONS"
          }
        }
      },
      {
        "name": "Build",
        "actions": [
          {
            "name": "Build",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "BuildspecOverride": "buildspec-build.yml",
              "ProjectName": "todo-react-build"
            },
            "outputArtifacts": [
              {
                "name": "BuildArtifact"
              }
            ],
            "inputArtifacts": [
              {
                "name": "SourceArtifact"
              }
            ],
            "region": "us-east-1",
            "namespace": "BuildVariables"
          }
        ],
        "onFailure": {
          "result": "RETRY",
          "retryConfiguration": {
            "retryMode": "ALL_ACTIONS"
          }
        }
      },
      {
        "name": "Scan",
        "actions": [
          {
            "name": "ScanImage",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "BuildspecOverride": "buildspec-scan.yml",
              "ProjectName": "todo-react-scan"
            },
            "outputArtifacts": [
              {
                "name": "ScannedArtifact"
              }
            ],
            "inputArtifacts": [
              {
                "name": "BuildArtifact"
              }
            ],
            "region": "us-east-1"
          }
        ],
        "onFailure": {
          "result": "RETRY",
          "retryConfiguration": {
            "retryMode": "ALL_ACTIONS"
          }
        }
      },
      {
        "name": "Deploy",
        "actions": [
          {
            "name": "DeployToEKS",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "BuildspecOverride": "buildspec-deploy.yml",
              "ProjectName": "todo-react-deploy"
            },
            "outputArtifacts": [],
            "inputArtifacts": [
              {
                "name": "ScannedArtifact"
              }
            ],
            "region": "us-east-1"
          }
        ]
      }
    ],
    "version": 11,
    "executionMode": "QUEUED",
    "pipelineType": "V2",
    "triggers": [
      {
        "providerType": "CodeStarSourceConnection",
        "gitConfiguration": {
          "sourceActionName": "Source",
          "push": [
            {
              "branches": {
                "includes": [
                  "main"
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
